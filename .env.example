# House Health Environment Variables

# Application
NEXT_PUBLIC_APP_NAME="House Health"
NEXT_PUBLIC_APP_VERSION="2.5.0"

# Azure Sovereign Enclave (UAE North)
AZURE_REGION="uae-north"
AZURE_STORAGE_ACCOUNT="anteriorhealthpacsae"
AZURE_KEY_VAULT_URL="https://anterior-health-kv.vault.azure.net/"

# FHIR R4 Server
FHIR_SERVER_URL="https://anterior-health-fhir.azurehealthcareapis.com"
FHIR_SERVER_VERSION="R4"

# OCR / Document Processing
OCR_ENGINE="azure-form-recognizer"
OCR_DPI="300"

# Audit & Compliance
AUDIT_LOG_RETENTION_DAYS="2555"
COMPLIANCE_FRAMEWORK="UAE_MOHAP_DHA"

# Feature Flags
ENABLE_WHATSAPP_INGESTION="true"
ENABLE_LIVE_RULES_ENGINE="true"
ENABLE_AUDIT_TRAIL="true"
